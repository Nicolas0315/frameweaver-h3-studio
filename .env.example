# Discord auth is implemented. Keep 0 only for a trusted local development instance.
DISCORD_AUTH_ENABLED=0
# To enable (1), supply all values through the existing secret environment, never commit real values:
# DISCORD_CLIENT_ID, DISCORD_CLIENT_SECRET
# DISCORD_REDIRECT_URI: HTTPS URL ending in /auth/callback
# DISCORD_ALLOWED_USER_IDS: comma-separated Discord user IDs
# FRAMEWEAVER_SESSION_SECRET: at least 32 bytes; never checked into source
# Incomplete enabled configuration fails closed at startup.
FRAMEWEAVER_WORKERS_JSON=
# The UI proxies /api, /auth, /rewriter and /comfy through frameweaverd.
# Development API: FRAMEWEAVER_API_URL=http://127.0.0.1:5181
# Local Comfy target (daemon setting): FRAMEWEAVER_COMFY_URL=http://127.0.0.1:8188
